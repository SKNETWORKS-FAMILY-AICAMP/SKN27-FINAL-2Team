{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TermResolutionDecision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "term_review_task_id",
    "resolution_case_id",
    "decision_status",
    "review_model",
    "prompt_version",
    "proposed_alternatives",
    "evidence_only_sources",
    "rejected_sources",
    "ambiguous_sources",
    "decision_reason"
  ],
  "properties": {
    "term_review_task_id": {"type": "string", "minLength": 1},
    "resolution_case_id": {"type": "string", "minLength": 1},
    "decision_status": {"type": "string", "const": "PROPOSED"},
    "review_model": {"type": "string", "minLength": 1},
    "prompt_version": {"type": "string", "minLength": 1},
    "proposed_alternatives": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "display_name",
          "entity_type",
          "identity_member_source_candidate_ids",
          "reason"
        ],
        "properties": {
          "display_name": {"type": "string", "minLength": 1},
          "entity_type": {
            "type": "string",
            "enum": [
              "Person",
              "Event",
              "Institution",
              "Heritage",
              "Work",
              "Organization",
              "Place",
              "Polity",
              "Concept"
            ]
          },
          "identity_member_source_candidate_ids": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "evidence_only_sources": {"$ref": "#/$defs/classifiedSources"},
    "rejected_sources": {"$ref": "#/$defs/classifiedSources"},
    "ambiguous_sources": {"$ref": "#/$defs/classifiedSources"},
    "decision_reason": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "classifiedSources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_candidate_id", "reason"],
        "properties": {
          "source_candidate_id": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
