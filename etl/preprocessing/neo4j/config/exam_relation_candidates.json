{
  "exam_relation_candidates": {
    "policy_version": "exam-relation-candidate-v1.0",
    "supported_data_sources": [
      "han_cj_v41",
      "han_cj_v41_image"
    ],
    "expected_choice_count": 5,
    "minimum_term_length": 2,
    "maximum_entities_per_segment": 8,
    "accepted_link_status": "ACCEPTED",
    "truth_statuses": {
      "true": "CONTEXTUALLY_TRUE",
      "false": "CONTEXTUALLY_FALSE",
      "dependent": "CONTEXT_DEPENDENT"
    },
    "question_task_truth_policy": {
      "standard_select": {
        "polarity": "POSITIVE_SELECT",
        "answer_truth": "CONTEXTUALLY_TRUE",
        "non_answer_truth": "CONTEXTUALLY_FALSE"
      },
      "negative_select": {
        "polarity": "NEGATIVE_SELECT",
        "answer_truth": "CONTEXTUALLY_FALSE",
        "non_answer_truth": "CONTEXTUALLY_TRUE"
      },
      "period_between": {
        "polarity": "COMPLEX_TASK",
        "answer_truth": "CONTEXT_DEPENDENT",
        "non_answer_truth": "CONTEXT_DEPENDENT"
      },
      "timeline_position": {
        "polarity": "COMPLEX_TASK",
        "answer_truth": "CONTEXT_DEPENDENT",
        "non_answer_truth": "CONTEXT_DEPENDENT"
      },
      "order": {
        "polarity": "COMPLEX_TASK",
        "answer_truth": "CONTEXT_DEPENDENT",
        "non_answer_truth": "CONTEXT_DEPENDENT"
      },
      "multi_select_combo": {
        "polarity": "COMPLEX_TASK",
        "answer_truth": "CONTEXT_DEPENDENT",
        "non_answer_truth": "CONTEXT_DEPENDENT"
      },
      "map_location": {
        "polarity": "COMPLEX_TASK",
        "answer_truth": "CONTEXT_DEPENDENT",
        "non_answer_truth": "CONTEXT_DEPENDENT"
      }
    },
    "claim_roles": {
      "material": "SOURCE_CONTEXT_CANDIDATE",
      "contextually_true": "TRUE_CHOICE_CLAIM",
      "contextually_false": "TARGET_MISALIGNED_RELATION_TEMPLATE",
      "context_dependent": "CONTEXT_DEPENDENT_CHOICE"
    },
    "candidate_statuses": {
      "official_corroboration_required": "NEEDS_OFFICIAL_CORROBORATION",
      "target_resolution_required": "TARGET_RESOLUTION_REQUIRED",
      "discovery_only": "DISCOVERY_ONLY",
      "blocked_false_context": "BLOCKED_FALSE_CONTEXT"
    },
    "claim_shape_patterns": [
      {
        "claim_shape": "LABELED_MAPPING",
        "pattern": "^[\\(\\[]?[가-하A-Za-z0-9]+[\\)\\]]?\\s*[-–:]"
      },
      {
        "claim_shape": "DECLARATIVE_CLAIM",
        "pattern": "(?:다|이다|하였다|되었다|있었다|없었다)\\.?$"
      },
      {
        "claim_shape": "SCENE_FRAGMENT",
        "pattern": "(?:하는|있는|없는)\\s+[^.]+$"
      }
    ],
    "default_claim_shape": "NOUN_OR_ACTIVITY_FRAGMENT",
    "relationship_trigger_rules": [
      {
        "predicate_family": "FOUND_OR_ESTABLISH",
        "patterns": [
          "설립",
          "창설",
          "창건",
          "건립",
          "세웠",
          "설치",
          "창시",
          "창도",
          "조직",
          "결성",
          "발족"
        ]
      },
      {
        "predicate_family": "CREATE_OR_PRODUCE",
        "patterns": [
          "제작",
          "만들",
          "조성",
          "축조",
          "주조",
          "창제",
          "건축",
          "중건"
        ]
      },
      {
        "predicate_family": "AUTHOR_OR_COMPILE",
        "patterns": [
          "저술",
          "편찬",
          "집필",
          "지었",
          "지은",
          "쓴",
          "작성",
          "저자"
        ]
      },
      {
        "predicate_family": "PUBLISH_OR_PRINT",
        "patterns": [
          "간행",
          "발행",
          "인쇄",
          "판각",
          "발간",
          "출판"
        ]
      },
      {
        "predicate_family": "IMPLEMENT_OR_ENACT",
        "patterns": [
          "실시",
          "시행",
          "반포",
          "제정",
          "폐지",
          "혁파",
          "단행",
          "도입",
          "실행"
        ]
      },
      {
        "predicate_family": "MOVE_OR_RETURN",
        "patterns": [
          "천도",
          "이주",
          "피란",
          "환궁",
          "이전",
          "옮겨",
          "이동"
        ]
      },
      {
        "predicate_family": "PARTICIPATE_OR_ACT",
        "patterns": [
          "참여",
          "활약",
          "활동",
          "농성",
          "시위",
          "주도",
          "가담",
          "참전"
        ]
      },
      {
        "predicate_family": "CONFLICT_OR_SUPPRESS",
        "patterns": [
          "전투",
          "항전",
          "격퇴",
          "토벌",
          "진압",
          "정벌",
          "침략",
          "시해",
          "난을 일으",
          "격파",
          "물리",
          "승리",
          "공격",
          "항쟁",
          "봉기"
        ]
      },
      {
        "predicate_family": "DIPLOMACY_OR_AGREEMENT",
        "patterns": [
          "체결",
          "협정",
          "조약",
          "회담",
          "파견",
          "교섭",
          "사절",
          "통상",
          "수교"
        ]
      },
      {
        "predicate_family": "LOCATION_OR_OCCURRENCE",
        "patterns": [
          "발생",
          "출토",
          "발견",
          "개최",
          "위치",
          "소재",
          "하구",
          "하류",
          "상류"
        ]
      },
      {
        "predicate_family": "APPOINT_OR_SERVE",
        "patterns": [
          "임명",
          "기용",
          "역임",
          "즉위",
          "등용",
          "취임",
          "재위"
        ]
      }
    ],
    "identifier": {
      "hash_algorithm": "sha256",
      "digest_length": 20,
      "segment_prefix": "exam-claim-segment:",
      "candidate_prefix": "exam-relation-candidate:"
    },
    "outputs": {
      "segment_claims": "exam_segment_claims.csv",
      "relation_candidates": "exam_relation_candidates.csv",
      "manifest": "exam_relation_candidate_manifest.json"
    }
  },
  "exam_relation_official_corroboration": {
