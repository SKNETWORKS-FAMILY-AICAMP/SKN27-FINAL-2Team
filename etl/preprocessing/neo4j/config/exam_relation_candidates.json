  "exam_relation_official_text_corroboration": {
    "policy_version": "exam-relation-official-text-v1.4",
    "source": "AKS",
    "source_record_prefix": "AKS:ARTICLE:",
    "text_fields": [
      "definition",
      "summary",
      "body"
    ],
    "supported_check_statuses": [
      "ENDPOINTS_UNRESOLVED",
      "OFFICIAL_FACT_NOT_FOUND",
      "RELATION_TYPE_MISMATCH",
      "PREDICATE_UNRESOLVED"
    ],
    "uncertainty_patterns": [
      "추정",
      "전해지",
      "가능성이",
      "불확실",
      "미상"
    ],
    "negation_patterns": [
      "않았",
      "아니었",
      "없었",
      "못하",
      "실패"
    ],
    "maximum_mentions_per_sentence": 12,
    "maximum_evidence_per_candidate": 5,
    "maximum_discovered_pairs_per_candidate": 25,
    "maximum_sentence_length": 1200,
    "minimum_two_explicit_source_count": 2,
    "safe_disambiguation": {
      "policy_version": "aks-canonical-disambiguation-v1.0",
      "minimum_definition_token_length": 2,
      "minimum_definition_overlap_count": 2,
      "minimum_definition_overlap_ratio": 0.2,
      "definition_stopwords": [
        "시대",
        "우리나라",
        "한국",
        "관련",
        "대한",
        "있는",
        "하는",
        "하던",
        "이다"
      ],
      "linked_eid_pattern": "\\[[^\\]]+\\]\\((?P<eid>E[0-9]+)\\)",
      "statuses": {
        "safe_match": "SAFE_MATCH",
        "ambiguous": "AMBIGUOUS",
        "no_safe_match": "NO_SAFE_MATCH"
      }
    },
    "search_statuses": {
      "supported": "SUPPORTED_BY_AKS_TEXT_STRICT",
      "insufficient_evidence": "AKS_TEXT_EVIDENCE_INSUFFICIENT",
      "no_support": "NO_AKS_TEXT_SUPPORT",
      "ambiguous_endpoints": "AMBIGUOUS_AKS_ENDPOINT_RECOVERY",
      "already_verified": "SKIPPED_ALREADY_VERIFIED",
      "predicate_missing": "SKIPPED_PREDICATE_UNRESOLVED",
      "endpoints_missing": "SKIPPED_ENDPOINTS_UNRESOLVED"
    },
    "identifier": {
      "hash_algorithm": "sha256",
      "digest_length": 20,
      "evidence_prefix": "exam-official-text-evidence:"
    },
    "outputs": {
      "text_checks": "exam_relation_official_text_checks.csv",
      "text_evidence": "exam_relation_official_text_evidence.csv",
      "aks_disambiguation": "aks_canonical_disambiguation.csv",
      "manifest": "exam_relation_official_text_manifest.json"
    }
  },
  "exam_relation_frames": {
    "policy_version": "exam-relation-frame-v1.0",
    "supported_search_statuses": [
      "SUPPORTED_BY_AKS_TEXT_STRICT"
    ],
    "atomic_clause_separator_pattern": "(?:하였으며|하였고|되었으며|되었고|시키고|시켜서|하면서|하지만|하고|하여|해서|되고|면서|지만|는데|으나|거나)\\s*|[.!?。]\\s*",
    "non_assertive_suffix_pattern": "^\\s*(?:을|를|의|에|에서|때)",
    "assertive_light_verb_suffix_pattern": "^\\s*(?:을|를)\\s*(?:하|했|하였다|함)",
    "passive_suffix_pattern": "^\\s*(?:되|됐|받)",
    "role_suffix_rules": [
      {
        "role": "ACTOR",
        "basis": "CENTERED_ON",
        "pattern": "^\\s*(?:을|를)\\s+중심으로"
      },
      {
        "role": "ACTOR",
        "basis": "POSSESSIVE_ACTOR_GROUP",
        "pattern": "^\\s*의\\s+(?:군대|세력|정부|일파|부대)(?:이|가|은|는)"
      },
      {
        "role": "ACTOR",
        "basis": "PASSIVE_AGENT",
        "pattern": "^\\s*(?:에\\s+의해|에게)"
      },
      {
        "role": "ACTOR",
        "basis": "COACTOR_WITH",
        "pattern": "^\\s*(?:등)?(?:와|과)\\s+함께"
      },
      {
        "role": "GRAMMATICAL_SUBJECT",
        "basis": "GROUP_SUBJECT_MARKER",
        "pattern": "^\\s*(?:세력\\s+)?등(?:의\\s+(?:단체|세력|인물))?(?:이|가|은|는)(?![가-힣])"
      },
      {
        "role": "GRAMMATICAL_SUBJECT",
        "basis": "SUBJECT_MARKER",
        "pattern": "^\\s*(?:이|가|은|는|께서)(?![가-힣])"
      },
      {
        "role": "TARGET",
        "basis": "OBJECT_MARKER",
        "pattern": "^\\s*(?:등)?(?:을|를)(?![가-힣])"
      },
      {
        "role": "LOCATION_OR_ROLE",
        "basis": "LOCATIVE_OR_ROLE_MARKER",
        "pattern": "^\\s*(?:등)?(?:에서|에|으로|로)(?![가-힣])"
      },
      {
        "role": "CONTEXT",
        "basis": "GENITIVE_OR_TIME_CONTEXT",
        "pattern": "^\\s*(?:의|때)(?![가-힣])"
      },
      {
        "role": "COORDINATED",
        "basis": "COORDINATION_MARKER",
        "pattern": "^\\s*(?:,|·|와|과)(?![가-힣])"
      }
    ],
    "place_entity_types": [
      "Place"
    ],
    "pair_role_sets_by_family": {
      "FOUND_OR_ESTABLISH": [
        ["ACTOR", "TARGET"]
      ],
      "CREATE_OR_PRODUCE": [
        ["ACTOR", "TARGET"]
      ],
      "AUTHOR_OR_COMPILE": [
        ["ACTOR", "TARGET"]
      ],
      "PUBLISH_OR_PRINT": [
        ["ACTOR", "TARGET"]
      ],
      "IMPLEMENT_OR_ENACT": [
        ["ACTOR", "TARGET"]
      ],
      "MOVE_OR_RETURN": [
        ["ACTOR", "LOCATION"]
      ],
      "PARTICIPATE_OR_ACT": [
        ["ACTOR", "CONTEXT"]
      ],
      "CONFLICT_OR_SUPPRESS": [
        ["ACTOR", "TARGET"]
      ],
      "DIPLOMACY_OR_AGREEMENT": [
        ["ACTOR", "TARGET"]
      ],
      "LOCATION_OR_OCCURRENCE": [
        ["TARGET", "LOCATION"]
      ],
      "APPOINT_OR_SERVE": [
        ["ACTOR", "TARGET"],
        ["TARGET", "ROLE"]
      ]
    },
    "frame_statuses": {
      "resolved": "ROLE_RESOLVED",
      "partial": "ROLE_PARTIAL",
      "ambiguous": "ROLE_AMBIGUOUS",
      "action_not_asserted": "ACTION_NOT_ASSERTED"
    },
    "pair_statuses": {
      "ready": "PAIR_READY_FOR_FACT_VALIDATION",
      "not_available": "PAIR_NOT_AVAILABLE",
      "action_not_asserted": "PAIR_BLOCKED_ACTION_NOT_ASSERTED"
    },
    "identifier": {
      "hash_algorithm": "sha256",
      "digest_length": 20,
      "frame_prefix": "exam-relation-frame:"
    },
    "outputs": {
      "frames": "exam_relation_frames.csv",
      "participants": "exam_relation_frame_participants.csv",
      "manifest": "exam_relation_frame_manifest.json"
    }
  }
}
