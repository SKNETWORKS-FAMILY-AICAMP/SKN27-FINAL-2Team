    ],
    "minimum_recovered_name_length_with_known_endpoint": 2,
    "minimum_recovered_name_length_without_known_endpoint": 3,
    "accepted_registry_status": "ACTIVE",
    "official_fact_neighbor_resolution_method": "OFFICIAL_FACT_NEIGHBOR",
