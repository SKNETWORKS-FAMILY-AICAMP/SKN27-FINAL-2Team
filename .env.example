EMBEDDING_DIMENSIONS=1536

CHAT_LLM_PROVIDER=openai
OPENAI_CHAT_MODEL=gpt-5.4-mini
RUNPOD_ENDPOINT_ID=
RUNPOD_API_KEY=
RUNPOD_SLLM_MODEL=cubixsamju/hanneung-qwen25-7b-v41-merged-47-78
ENCYKOREA_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=gemma4:2b
CHAT_TEMPERATURE=0.2

# Email verification
# 개발 중에는 console backend를 쓰면 인증번호가 서버 터미널에 출력됩니다.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=himate@example.com --2team  공용메일
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your_email@example.com  2team  공용메일
EMAIL_HOST_PASSWORD=your_email_password
EMAIL_USE_TLS=true


RAG_RERANKER_ENABLED=true
RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
