POSTGRES_DB=history_rag
POSTGRES_HOST=localhost
POSTGRES_USER=himate
POSTGRES_PASSWORD=himate1234
POSTGRES_PORT=5432
POSTGRES_CONNECT_TIMEOUT_SECONDS=5

NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me
NEO4J_URI=bolt://localhost:7687
NEO4J_CONNECT_TIMEOUT_SECONDS=3
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
FACT_NEO4J_HTTP_PORT=7475
FACT_NEO4J_BOLT_PORT=7688
NEO4J_HEAP_INITIAL=512m
NEO4J_HEAP_MAX=1G
NEO4J_PAGECACHE=512m
NEO4J_TX_MEMORY_MAX=512m

# 문제 생성용 Fact Neo4j
FACT_NEO4J_USER=neo4j
FACT_NEO4J_PASSWORD=change_me
FACT_NEO4J_URI=bolt://localhost:7688
FACT_NEO4J_HTTP_PORT=7475
FACT_NEO4J_BOLT_PORT=7688
FACT_NEO4J_HEAP_INITIAL=512m
FACT_NEO4J_HEAP_MAX=1G
FACT_NEO4J_PAGECACHE=512m
FACT_NEO4J_TX_MEMORY_MAX=512m

OPENAI_API_KEY=your_openai_api_key
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

CHAT_LLM_PROVIDER=openai
OPENAI_CHAT_MODEL=gpt-5.6-terra
OPENAI_PACK_PLAN_MODEL=gpt-5.4-mini
OPENAI_EVAL_MODEL=gpt-5.6-terra
QGEN_CLOSED_PACK_INPUT=
QGEN_V41_VALIDATION=
QGEN_OFFICIAL_DATA=
QGEN_IMAGE_PACK_MANIFEST=
QGEN_RUN_DIR=
RUNPOD_ENDPOINT_ID=
RUNPOD_API_KEY=
RUNPOD_SLLM_MODEL=cubixsamju/hanneung-qwen25-7b-v41-merged-47-78
ENCYKOREA_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=gemma4:2b
CHAT_TEMPERATURE=0.1

# Email verification
# 개발 중에는 console backend를 쓰면 인증번호가 서버 터미널에 출력됩니다.
# 운영 SMTP에는 팀 공용 메일 계정을 사용합니다.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=himate@example.com
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your_email@example.com
EMAIL_HOST_PASSWORD=your_email_password
EMAIL_USE_TLS=true


RAG_RERANKER_ENABLED=false
RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RAG_BM25_ENABLED=true
# Per-channel vector/BM25 candidates. Keep 50 for normal operation.
RAG_RETRIEVAL_CANDIDATE_POOL=50
# RRF candidates sent to BGE. 0 keeps the existing automatic limit.
RAG_RERANK_CANDIDATE_POOL=0

# LangSmith evaluation tracing
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_api_key
LANGSMITH_PROJECT=himate-rag-evaluation

# AKS Encyclopedia OpenAPI
AKS_API_KEY=your_aks_api_key

# 주간 리포트 전용 모델. 미설정 시 OPENAI_CHAT_MODEL 사용.
# 소형(mini) 모델은 구조화 출력이 깨져 기본 문구로 떨어질 수 있어 5.5 이상 권장.
WEEKLY_REPORT_LLM_MODEL=gpt-5.5


# .\.venv\Scripts\python.exe -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,testserver
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
DJANGO_TRUST_X_FORWARDED_PROTO=false
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false
