# EC2의 EC2_WEB_ENV_FILE 경로에 복사한 뒤 실제 값으로 변경합니다.
# 비밀값은 이 파일에 넣지 않고 SSM Parameter Store SecureString으로 관리합니다.
# EC2_WEB_SSM_PARAMETER_PREFIX가 /himate/prod라면 다음 이름으로 생성합니다.
# /himate/prod/POSTGRES_PASSWORD
# /himate/prod/NEO4J_PASSWORD
# /himate/prod/OPENAI_API_KEY
# /himate/prod/DJANGO_SECRET_KEY
# /himate/prod/EMAIL_HOST_PASSWORD

POSTGRES_DB=replace_with_database_name
POSTGRES_HOST=replace_with_reachable_database_host
POSTGRES_USER=replace_with_database_user
POSTGRES_PORT=5432
POSTGRES_CONNECT_TIMEOUT_SECONDS=5
POSTGRES_SSLMODE=verify-full
POSTGRES_SSLROOTCERT=/etc/ssl/certs/aws-rds-global-bundle.pem
POSTGRES_REQUIRED_TABLES=user_accounts,questions,question_options,exam_data,chat_sessions,chat_messages,solve_sessions,solve_records,analytics,note_mypage,study_plan_mypage,email_verification_codes,ml_trend_top5

NEO4J_URI=bolt+s://replace_with_reachable_neo4j_host:7687
NEO4J_USER=neo4j
NEO4J_CONNECT_TIMEOUT_SECONDS=3

EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
OPENAI_CHAT_MODEL=replace_with_chat_model

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=replace_with_sender_address
EMAIL_HOST=replace_with_smtp_host
EMAIL_PORT=587
EMAIL_HOST_USER=replace_with_smtp_user
EMAIL_USE_TLS=true

DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=replace_with_service_domain
DJANGO_HEALTHCHECK_HOST=replace_with_service_domain
DJANGO_CSRF_TRUSTED_ORIGINS=https://replace_with_service_domain
DJANGO_TRUST_X_FORWARDED_PROTO=true
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_SECURE=true
DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false

# 컨테이너 안에서 localhost는 EC2 호스트나 다른 컨테이너를 가리키지 않습니다.
# 외부 DB는 접근 가능한 DNS를 사용하세요.
# 같은 EC2의 DB 컨테이너는 공통 Docker network에 연결하고 서비스명을 사용하세요.
