# 같은 리전의 Parameter Store에 /himate/prod/<변수명>으로 생성합니다.
# 비밀번호, API Key, DJANGO_SECRET_KEY, FACT_NEO4J_AUTH는 SecureString을 사용합니다.
# RunPod 값은 문제 생성 배치에서만 사용하고 Web Task에는 주입하지 않습니다.

POSTGRES_DB=replace_with_database_name
POSTGRES_HOST=replace_with_aurora_cluster_endpoint
POSTGRES_USER=replace_with_database_user
POSTGRES_PASSWORD=replace_with_secure_password
POSTGRES_PORT=5432
POSTGRES_CONNECT_TIMEOUT_SECONDS=30
POSTGRES_CONN_MAX_AGE=0
POSTGRES_SSLMODE=verify-full
POSTGRES_SSLROOTCERT=/etc/ssl/certs/aws-rds-global-bundle.pem
POSTGRES_REQUIRED_TABLES=user_accounts,questions,question_options,exam_data,chat_sessions,chat_messages,solve_sessions,solve_records,analytics,note_mypage,study_plan_mypage,email_verification_codes,ml_trend_top5

# 챗봇이 상시 사용하는 Main Neo4j(AuraDB Free)
NEO4J_URI=neo4j+s://replace_with_aura_instance_id.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace_with_aura_password
NEO4J_CONNECT_TIMEOUT_SECONDS=3

# 문제 생성 때만 시작하는 Fact Neo4j
FACT_NEO4J_URI=bolt://replace_with_fact_ec2_private_ipv4:7687
FACT_NEO4J_USER=neo4j
FACT_NEO4J_PASSWORD=replace_with_fact_neo4j_password
FACT_NEO4J_AUTH=neo4j/replace_with_the_same_fact_neo4j_password
FACT_NEO4J_CONNECT_TIMEOUT_SECONDS=3

EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
OPENAI_API_KEY=replace_with_secure_api_key
OPENAI_CHAT_MODEL=replace_with_model_name

# Web OAuth. Client secrets use SecureString; other values use String.
OAUTH_REDIRECT_BASE_URL=https://himate-edu.com
GOOGLE_OAUTH_CLIENT_ID=replace_with_google_client_id
GOOGLE_OAUTH_CLIENT_SECRET=replace_with_secure_client_secret
KAKAO_OAUTH_CLIENT_ID=replace_with_kakao_client_id
KAKAO_OAUTH_CLIENT_SECRET=replace_with_secure_client_secret
NAVER_OAUTH_CLIENT_ID=replace_with_naver_client_id
NAVER_OAUTH_CLIENT_SECRET=replace_with_secure_client_secret

# 문제 생성 배치 전용
RUNPOD_ENDPOINT_ID=replace_with_serverless_endpoint_id
RUNPOD_API_KEY=replace_with_secure_api_key
RUNPOD_SLLM_MODEL=replace_with_runpod_model_name

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=replace_with_sender_address
EMAIL_HOST=replace_with_smtp_host
EMAIL_PORT=587
EMAIL_HOST_USER=replace_with_smtp_user
EMAIL_HOST_PASSWORD=replace_with_secure_password
EMAIL_USE_TLS=true

DJANGO_SECRET_KEY=replace_with_at_least_50_random_characters
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=replace_with_service_domain
DJANGO_HEALTHCHECK_HOST=localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://replace_with_service_domain
DJANGO_TRUST_X_FORWARDED_PROTO=true
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_SECURE=true
DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false
