# himate 웹 앞단 리버스 프록시 템플릿.
#
# deployment/deploy.sh가 검증된 release 변수로 자리표시자를 치환하고,
# nginx -t가 성공한 경우에만 실제 EC2 설정에 반영한다.

# ── rate limit 존 ────────────────────────────────────────────────────────────
# 로그인/회원가입 계열은 계정 잠금 남용·무차별 대입 방어를 위해 좁게 건다.
limit_req_zone $binary_remote_addr zone=himate_auth:10m rate=5r/m;
# 일반 트래픽은 폭주 방어용으로 느슨하게 건다.
limit_req_zone $binary_remote_addr zone=himate_general:10m rate=30r/s;

upstream himate_web {
    server __EC2_WEB_BIND_HOST__:__EC2_WEB_HOST_PORT__;
    keepalive 32;
}

server {
    listen 80 default_server;
    server_name _;

    return 444;
}

server {
    listen 80;
    server_name __EC2_WEB_SERVER_NAME__;

    location ^~ /.well-known/acme-challenge/ {
        root __EC2_WEB_CERTBOT_WEBROOT__;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2 default_server;
    server_name _;

    ssl_reject_handshake on;
}

server {
    listen 443 ssl http2;
    server_name __EC2_WEB_SERVER_NAME__;

    ssl_certificate     __EC2_WEB_TLS_CERTIFICATE_PATH__;
    ssl_certificate_key __EC2_WEB_TLS_PRIVATE_KEY_PATH__;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:himate_ssl:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;
    server_tokens off;

    # 업로드/응답 본문 상한(이미지 프록시 등 큰 응답 대비).
    client_max_body_size 12m;

    # ── liveness: 가볍고 자주 호출되는 경로 ────────────────────────────────
    # DB·Neo4j 를 건드리지 않는다. 로드밸런서/uptime 체크는 이 경로를 쓴다.
    location = /health/live/ {
        proxy_pass http://himate_web;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        access_log off;
    }

    # ── readiness: DB·Neo4j 까지 검사하는 무거운 경로 ─────────────────────
    # 외부 노출을 막고 내부(로컬/사설망)에서만 호출하게 한다.
    location = /health/ {
        allow 127.0.0.1;
        allow __EC2_WEB_PRIVATE_NETWORK_CIDR__;
        deny all;
        proxy_pass http://himate_web;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        access_log off;
    }

    # ── 인증 계열: 좁은 rate limit ────────────────────────────────────────
    location ~ ^/(user/(login|register|send-verification-code|verify-verification-code|check-nickname)/|admin/login/)$ {
        limit_req zone=himate_auth burst=10 nodelay;
        limit_req_status 429;
        proxy_pass http://himate_web;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
    }

    location = /chatbot/api/rag/stream/ {
        limit_req zone=himate_general burst=60 nodelay;
        limit_req_status 429;
        proxy_pass http://himate_web;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 130s;
        proxy_send_timeout 130s;
    }

    # ── 그 외 전체 ────────────────────────────────────────────────────────
    location / {
        limit_req zone=himate_general burst=60 nodelay;
        limit_req_status 429;
        proxy_pass http://himate_web;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";

        proxy_read_timeout 130s;
    }
}
